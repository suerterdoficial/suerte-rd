{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data.json"
    }
  },
  "rewrites": [
    { "source": "/admin.", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
